FUNCTION_BLOCK "FB_App"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      frequencySource_Last : Int;
      frequencySetpoint_Last : Real;
      state_start : Bool := true;
      state_rev : Bool := true;
      state_stop : Bool := true;
      i : Int;
      state_alarm : Bool;
      hbLast : Word;
      hbArmed : Bool;
      hbChanged : Bool;
      hbTimer {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
   END_VAR


BEGIN
	
	"FC_ModbusSrv"();
	"FC_ModbusMaster"();
	"DB_Sensors"();
	
	// Контроль связи с ноутбуком: HoldingReg[17] = heartbeat, [18] = связь потеряна
	#hbChanged := FALSE;
	IF "DB_MB_TCP_ServerConfig".HoldingReg[17] = 0 THEN
	    #hbArmed := FALSE;
	    #hbLast := 0;
	ELSIF "DB_MB_TCP_ServerConfig".HoldingReg[17] <> #hbLast THEN
	    #hbLast := "DB_MB_TCP_ServerConfig".HoldingReg[17];
	    #hbArmed := TRUE;
	    #hbChanged := TRUE;
	    "DB_MB_TCP_ServerConfig".HoldingReg[18] := 0;
	END_IF;
	// измнение времени работы после отключения ноутбука
	#hbTimer(IN := #hbArmed AND NOT #hbChanged,
	         PT := T#3s);
	
	IF #hbTimer.Q THEN
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X0 := FALSE;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X1 := FALSE;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X8 := TRUE;
	    "DB_MB_TCP_ServerConfig".HoldingReg[17] := 0;
	    "DB_MB_TCP_ServerConfig".HoldingReg[18] := 1;
	    #hbLast := 0;
	    #hbArmed := FALSE;
	END_IF;
	
	
	// ПУСК РЕВЕРС СТОП. Можно добавить условие, если все флаги равны false, то поставить все флаги в true. Ну или хотя бы флаг стоп
	IF #state_start = false AND #state_rev = false AND #state_stop = false THEN
	    #state_start := true;
	    #state_rev := true;
	    #state_stop := true;
	END_IF;
	    IF "DB_MB_TCP_ServerConfig".HoldingReg[0].%X0 = 1 AND #state_start = TRUE THEN
	    #state_start := false;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X1 := false;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X8 := false;
	    "DB_MB_RTU_MasterConfig".StepRequest := "WriteMotorOnOff";
	    #state_rev := true;
	    #state_stop := true;
	    "DB_HMI_Data".motorForwardOn := true;
	    "DB_HMI_Data".motorReversOn := false;
	    "DB_HMI_Data".motorStop := false;
	END_IF;
	IF "DB_MB_TCP_ServerConfig".HoldingReg[0].%X1 = 1 AND #state_rev = TRUE THEN
	    #state_rev := FALSE;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X0 := false;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X8 := false;
	    "DB_MB_RTU_MasterConfig".StepRequest := "WriteMotorOnOff";
	    #state_start := TRUE;
	    #state_stop := true;
	    "DB_HMI_Data".motorForwardOn := FALSE;
	    "DB_HMI_Data".motorReversOn := true;
	    "DB_HMI_Data".motorStop := false;
	END_IF;
	IF "DB_MB_TCP_ServerConfig".HoldingReg[0].%X8 = 1 AND #state_stop = TRUE THEN
	    #state_stop := false;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X0 := false;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X1 := false;
	    "DB_MB_RTU_MasterConfig".StepRequest := "WriteMotorOnOff";
	    #state_start := TRUE;
	    #state_rev := true;
	    "DB_HMI_Data".motorForwardOn := false;
	    "DB_HMI_Data".motorReversOn := false;
	    "DB_HMI_Data".motorStop := true;
	END_IF;
	
	
	// УСТАВКА ЧАСТОТЫ
	// REAL -> два holding-регистра [1] и [2]
	"DB_HMI_Data".frequencySetpoint := DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD("DB_MB_TCP_ServerConfig".HoldingReg[1]), N := 16) OR
	                                                 WORD_TO_DWORD("DB_MB_TCP_ServerConfig".HoldingReg[2]));
	IF "DB_HMI_Data".frequencySetpoint <> #frequencySetpoint_Last THEN
	    "DB_MB_RTU_MasterConfig".StepRequest := "WriteFrequencySetpoint";
	    #frequencySetpoint_Last := "DB_HMI_Data".frequencySetpoint;
	END_IF;
	
	// АКТУАЛЬНАЯ ЧАСТОТА
	// REAL -> два holding-регистра [3] и [4]
	"DB_MB_TCP_ServerConfig".HoldingReg[3] :=
	DWORD_TO_WORD(SHR(IN := REAL_TO_DWORD("DB_VFD_Data".outputFrequency), N:= 16));     // high word
	"DB_MB_TCP_ServerConfig".HoldingReg[4] :=
	DWORD_TO_WORD(REAL_TO_DWORD("DB_VFD_Data".outputFrequency) AND 16#FFFF);     // low word
	"DB_HMI_Data".frequencyActual := "DB_VFD_Data".outputFrequency;
	
	
	// ВЫБОР ИСТОЧНИКА ЗАДАНИЯ ЧАСТОТЫ
	// Int ->holding-регистр [5]
	"DB_HMI_Data".frequencySource := WORD_TO_INT("DB_MB_TCP_ServerConfig".HoldingReg[5]);
	IF "DB_HMI_Data".frequencySource <> #frequencySource_Last THEN
	    "DB_MB_RTU_MasterConfig".StepRequest := "WriteSpeedSourceSelect";
	    #frequencySource_Last := "DB_HMI_Data".frequencySource;
	END_IF;
	
	// ТОК
	// REAL -> Два holding-регистра [6] [7]
	"DB_MB_TCP_ServerConfig".HoldingReg[6] :=
	DWORD_TO_WORD(SHR(IN := REAL_TO_DWORD("DB_VFD_Data".outputCurrent), N:=16));
	"DB_MB_TCP_ServerConfig".HoldingReg[7] :=
	DWORD_TO_WORD(REAL_TO_DWORD("DB_VFD_Data".outputCurrent) AND 16#FFFF);
	"DB_HMI_Data".currentOut := "DB_VFD_Data".outputCurrent;
	
	// ВЫХОДНОЕ НАПРЯЖКНИЕ
	// Real -> Два holding-регистра [8] и [9]
	"DB_MB_TCP_ServerConfig".HoldingReg[8] :=
	DWORD_TO_WORD(SHR(IN := REAL_TO_DWORD("DB_VFD_Data".outputVoltage), N := 16));
	"DB_MB_TCP_ServerConfig".HoldingReg[9] :=
	DWORD_TO_WORD(REAL_TO_DWORD("DB_VFD_Data".outputVoltage) AND 16#FFFF);
	"DB_HMI_Data".voltageOut := "DB_VFD_Data".outputVoltage;
	
	// holding-регистра [10]
	// ВКЛ/ВЫКЛ ДАТЧИК использую только 0 бит.
	// PLC Online 1 bit
	// VFD Online 2 bit
	"DB_HMI_Data".sensorOn := "DB_MB_TCP_ServerConfig".HoldingReg[10].%X0;
	"DB_HMI_Data".plcOnline := "MB_SERVER_DB".Connected;
	"DB_MB_TCP_ServerConfig".HoldingReg[10].%X1 := "MB_SERVER_DB".Connected;
	
	// ВРЕМЯ РАБОТЫ ДВИГАТЕЛЯ ПРИ СРАБАТЫВАНИИ ДАТЧИКА 
	//  holding-регистра [12] и [13]
	"DB_HMI_Data".timerDelayMotorSensorsOn := INT_TO_TIME(REAL_TO_INT((DWORD_TO_REAL(SHL(IN := WORD_TO_DWORD("DB_MB_TCP_ServerConfig".HoldingReg[12]), N := 16) OR
	                                                        WORD_TO_DWORD("DB_MB_TCP_ServerConfig".HoldingReg[13])))*1000));
	"DB_Sensors".timeDelay := "DB_HMI_Data".timerDelayMotorSensorsOn;
	
	// поиск аварии и вывод на панель номера аварии
	// holding-регистр [11]
	IF #state_alarm = FALSE AND "DB_MB_TCP_ServerConfig".HoldingReg[11] = 0 THEN
	    FOR #i := 0 TO 18 DO
	        IF "DB_VFD_Data".alarms[#i] = 1 THEN
	            #state_alarm := true;
	            "DB_MB_RTU_MasterConfig".StepRequest := "ReadAlarmHistory";
	            CASE #i OF
	                "alarm_UV1":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_UV1");
	                    EXIT;
	                "alarm_UV3":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_UV3");
	                    EXIT;
	                "alarm_SC":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_SC");
	                    EXIT;
	                "alarm_OC":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_OC");
	                    EXIT;
	                "alarm_OV":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_OV");
	                    EXIT;
	                "alarm_OH":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_OH");
	                    EXIT;
	                "alarm_OL1":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_OL1");
	                    EXIT;
	                "alarm_OL2":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_OL2");
	                    EXIT;
	                "alarm_CPF03":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_CPF03");
	                    EXIT;
	                "alarm_StopMod_LowZPT":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_StopMod_LowZPT");
	                    EXIT;
	                "alarm_StopMod_HighZPT":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_StopMod_HighZPT");
	                    EXIT;
	                "alarm_StopMod_OverheatingRadiator":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_StopMod_OverheatingRadiator");
	                    EXIT;
	                "alarm_StopMod_bb":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_StopMod_bb");
	                    EXIT;
	                "alarm_CTER":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_CTER");
	                    EXIT;
	                "alarm_ES":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_ES");
	                    EXIT;
	                "alarm_STP0":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_STP0");
	                    EXIT;
	                "alarm_STP1":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_STP1");
	                    EXIT;
	                "alarm_STP2":
	                    "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD("alarm_STP2");
	                    EXIT;
	            END_CASE;
	        END_IF;
	    END_FOR;
	END_IF;
	// сброс аварии 
	IF "DB_MB_TCP_ServerConfig".HoldingReg[0].%X9 = 1 THEN
	    IF #state_alarm = TRUE THEN
	        "DB_MB_RTU_MasterConfig".StepRequest := "WriteResetAlarm";
	        "DB_MB_TCP_ServerConfig".HoldingReg[11] := INT_TO_WORD(0);
	        #state_alarm := FALSE;
	        "DB_VFD_Data".alarms[#i] := 0;
	    END_IF;
	    "DB_MB_TCP_ServerConfig".HoldingReg[0].%X9 := 0;
	END_IF;
	
	// ALarm history
	"DB_MB_TCP_ServerConfig".HoldingReg[14] := "DB_VFD_Data".lastAlarm;
	"DB_MB_TCP_ServerConfig".HoldingReg[15] := "DB_VFD_Data".secondAlarm;
	"DB_MB_TCP_ServerConfig".HoldingReg[16] := "DB_VFD_Data".thirdAlarm;
	
	
END_FUNCTION_BLOCK

